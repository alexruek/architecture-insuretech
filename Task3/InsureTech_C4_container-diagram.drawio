        <object placeholders="1" c4Type="Relationship" c4Technology="тема products-tariffs" c4Description="Публикует обновления продуктов и тарифов" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;%c4Description%&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;" id="ev-products-publish">
