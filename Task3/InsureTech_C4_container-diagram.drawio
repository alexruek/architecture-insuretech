<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="insuretech-c4-containers" name="Container diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2840" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="InsureTech - диаграмма контейнеров после перехода на Event-Driven архитектуру" style="text;align=left;verticalAlign=middle;fontSize=18;fontColor=#333333;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="&lt;font style=&quot;font-size: 16px&quot;&gt;InsureTech&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;" style="rounded=1;fontSize=11;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;noLabel=0;labelPadding=0;allowArrows=0;connectable=0;expand=0;recursiveResize=0;editable=1;pointerEvents=0;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="2180" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;font style=&quot;font-size: 16px&quot;&gt;Клиент&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Частный клиент, подбирает и оформляет страховки&lt;/font&gt;&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1">
          <mxGeometry x="1010" y="30" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="partner" value="&lt;font style=&quot;font-size: 16px&quot;&gt;Партнер&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Корпоративный клиент, встраивает страховые услуги в свои продукты&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;fontSize=12;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="1480" y="60" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;font style=&quot;font-size: 16px&quot;&gt;Веб-приложение&lt;/font&gt;&lt;div&gt;[Container: веб-приложение в браузере]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Подбор и оформление страховок, личный кабинет&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;fontSize=12;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="980" y="310" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="core" value="&lt;font style=&quot;font-size: 16px&quot;&gt;core-app&lt;/font&gt;&lt;div&gt;[Container: бэкенд-приложение]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Продукты, оформление заявок, оформленные страховки. Фоновый обработчик публикует события из таблицы outbox&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;fontSize=12;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="980" y="600" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="clientinfo" value="&lt;font style=&quot;font-size: 16px&quot;&gt;client-info&lt;/font&gt;&lt;div&gt;[Container: сервис]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Управление клиентскими данными&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;fontSize=12;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="500" y="600" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="db_client" value="&lt;font style=&quot;font-size: 16px&quot;&gt;БД client-info&lt;/font&gt;&lt;div&gt;[Container: PostgreSQL, схема client_info]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Данные клиентов&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="db_core" value="&lt;font style=&quot;font-size: 16px&quot;&gt;БД core-app&lt;/font&gt;&lt;div&gt;[Container: PostgreSQL, схема core_app]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Заявки и страховки, реплика продуктов и тарифов, таблица outbox&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="1500" y="600" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="kafka" value="&lt;font style=&quot;font-size: 16px&quot;&gt;Apache Kafka&lt;/font&gt;&lt;div&gt;[Container: брокер сообщений, 3 брокера в 3 зонах]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Инфраструктура, не функциональный сервис.&lt;br&gt;Тема products-tariffs: продукты и тарифы&lt;br&gt;Тема policies-issued: оформленные страховки&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;size=15;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="920" y="930" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="agg" value="&lt;font style=&quot;font-size: 16px&quot;&gt;ins-product-aggregator&lt;/font&gt;&lt;div&gt;[Container: сервис]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Интеграция со страховыми компаниями, единый список продуктов и тарифов&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;fontSize=12;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="500" y="1200" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="settle" value="&lt;font style=&quot;font-size: 16px&quot;&gt;ins-comp-settlement&lt;/font&gt;&lt;div&gt;[Container: сервис]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Взаиморасчеты со страховыми компаниями, реестр оформленных страховок&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;fontSize=12;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="1500" y="1200" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="db_settle" value="&lt;font style=&quot;font-size: 16px&quot;&gt;БД ins-comp-settlement&lt;/font&gt;&lt;div&gt;[Container: PostgreSQL, схема settlement]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Реестр страховок, реплика продуктов и тарифов, обработанные события&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="1920" y="1200" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="insurers" value="&lt;font style=&quot;font-size: 16px&quot;&gt;Страховые компании&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Сейчас пять компаний, планируется десять. REST API каждой компании&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;fontSize=12;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
          <mxGeometry x="980" y="1480" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n_legend" value="Обозначения&lt;br&gt;Серая сплошная стрелка - синхронный вызов (REST, SQL).&lt;br&gt;Оранжевая штриховая стрелка - асинхронное событие через брокер, направление стрелки совпадает с направлением потока данных.&lt;br&gt;В квадратных скобках на оранжевых стрелках указана тема брокера и группа потребителей." style="text;align=left;verticalAlign=top;spacing=8;fontSize=12;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#828282;" vertex="1" parent="1">
          <mxGeometry x="2270" y="40" width="530" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n_es" value="Что переведено на Event-Streaming&lt;br&gt;1. Продукты и тарифы. Было: core-app раз в 15 минут и ins-comp-settlement раз в сутки вызывали REST API ins-product-aggregator, который в том же запросе опрашивал все страховые компании. Стало: ins-product-aggregator публикует изменения в тему products-tariffs, оба сервиса читают ее и обновляют свои реплики.&lt;br&gt;2. Оформленные страховки. Было: ins-comp-settlement раз в сутки забирал у core-app все страховки за день одним запросом по REST. Стало: core-app публикует событие о каждой страховке в тему policies-issued, ins-comp-settlement ведет реестр по мере поступления.&lt;br&gt;Прямых вызовов между core-app, ins-comp-settlement и ins-product-aggregator не осталось.&lt;br&gt;Декомпозиция не менялась: сервисы и их обязанности прежние, добавлен только брокер как инфраструктура." style="text;align=left;verticalAlign=top;spacing=8;fontSize=12;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="2270" y="210" width="530" height="330" as="geometry" />
        </mxCell>
        <mxCell id="n_outbox" value="Transactional Outbox&lt;br&gt;Применяется в core-app. Страховка и событие о ней записываются в базу одной транзакцией: строка в таблице страховок и строка в таблице outbox. Фоновый обработчик внутри core-app читает outbox и публикует события в тему policies-issued, после подтверждения брокера помечает строку отправленной. Реплики core-app делят строки через SELECT FOR UPDATE SKIP LOCKED, поэтому одно событие не отправляют две реплики одновременно.&lt;br&gt;Причина: потерянное событие это неучтенная страховка в реестре взаиморасчетов. Доставка получается не менее одного раза, дубли отсекает потребитель.&lt;br&gt;Не применяется в ins-product-aggregator. Сервис не меняет собственных данных, источник данных это API страховых компаний. Если публикация не удалась, тот же продукт будет опубликован в следующем цикле опроса." style="text;align=left;verticalAlign=top;spacing=8;fontSize=12;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="2270" y="560" width="530" height="330" as="geometry" />
        </mxCell>
        <mxCell id="n_broker" value="Брокер и темы&lt;br&gt;Apache Kafka: 3 брокера, по одному в зоне доступности, фактор репликации 3, min.insync.replicas 2, издатели пишут с acks=all. Потеря одной зоны не останавливает запись и чтение.&lt;br&gt;Тема products-tariffs: ключ события - страховая компания и продукт, очистка compaction. В теме всегда есть последнее состояние каждого продукта, новая или отставшая реплика восстанавливается чтением темы с начала.&lt;br&gt;Тема policies-issued: ключ события - идентификатор страховки. Срок хранения покрывает допустимый простой ins-comp-settlement, после простоя сервис продолжает чтение с сохраненной позиции." style="text;align=left;verticalAlign=top;spacing=8;fontSize=12;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#828282;" vertex="1" parent="1">
          <mxGeometry x="2270" y="910" width="530" height="290" as="geometry" />
        </mxCell>
        <mxCell id="n_consumers" value="Потребители&lt;br&gt;Идемпотентность: продукты и тарифы обновляются по ключу и версии, более старая версия пропускается. События страховок несут уникальный идентификатор, ins-comp-settlement хранит обработанные идентификаторы и не учитывает страховку дважды.&lt;br&gt;Порядок событий сохраняется в пределах ключа.&lt;br&gt;Сервисы работают в нескольких экземплярах: экземпляры одного сервиса входят в одну группу потребителей, событие обрабатывает один из них.&lt;br&gt;Событие, которое не удалось обработать после повторов, уходит в отдельную тему ошибок и не блокирует остальные." style="text;align=left;verticalAlign=top;spacing=8;fontSize=12;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#828282;" vertex="1" parent="1">
          <mxGeometry x="2270" y="1220" width="530" height="270" as="geometry" />
        </mxCell>
        <mxCell id="n_poll" value="Опрос страховых компаний&lt;br&gt;ins-product-aggregator опрашивает компании по расписанию, а не по запросу потребителей. Каждая компания опрашивается независимо, со своим таймаутом и повтором: медленная или недоступная компания задерживает только свои данные.&lt;br&gt;Подключение еще пяти компаний добавляет пять независимых опросов и не меняет core-app и ins-comp-settlement." style="text;align=left;verticalAlign=top;spacing=8;fontSize=12;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#828282;" vertex="1" parent="1">
          <mxGeometry x="2270" y="1510" width="530" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e_client_web" value="Подбирает и оформляет страховки&lt;br&gt;[HTTPS]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_web_core" value="Продукты, заявки, страховки&lt;br&gt;[REST, JSON/HTTPS]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="core">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-100" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_web_client" value="Данные клиента в личном кабинете&lt;br&gt;[REST, JSON/HTTPS]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="clientinfo">
          <mxGeometry relative="1" x="-0.3" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_partner_core" value="Страховые услуги для продуктов партнера&lt;br&gt;[REST API, JSON/HTTPS]" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="partner" target="core">
          <mxGeometry relative="1" x="0.1" as="geometry">
            <Array as="points">
              <mxPoint x="1610" y="520" />
              <mxPoint x="1175" y="520" />
            </Array>
