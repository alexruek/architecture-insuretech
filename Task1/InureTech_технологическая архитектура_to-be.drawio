6 4;strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" parent="1" source="users" target="dns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_cdn_static" value="загрузка статики из источника;&lt;br&gt;при недоступности источника CDN отдает кеш" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="cdn" target="static"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_aggr_ins" value="REST API страховых компаний&lt;br&gt;(вызовы идут из каждой зоны)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="aggr_d" target="insurers"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_registry" value="образы и манифесты, развертывание&lt;br&gt;во все кластеры по очереди" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=open;dashed=1;dashPattern=6 4;strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" parent="1" source="registry" target="vpc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note_k8s" value='&lt;font style="font-size:14px"&gt;Kubernetes: три независимых кластера&lt;/font&gt;&lt;br&gt;&lt;br&gt;В каждой зоне свой кластер Managed Kubernetes, растянутый кластер не используется. Причины: отказ или неудачное обновление одного кластера не затрагивает две другие зоны; control plane не зависит от межзонной сети; кластеры обновляются по очереди без простоя сервиса. Во всех кластерах одинаковые манифесты из одного репозитория. Две оставшиеся зоны принимают всю нагрузку при потере третьей: HPA и Cluster Autoscaler добавляют поды и узлы.' style="text;align=left;verticalAlign=top;spacing=8;fontSize=12;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#5282ff;" vertex="1" parent="cloud"><mxGeometry x="1970" y="500" width="540" height="300" as="geometry"/></mxCell><mxCell id="alb" value="Application Load Balancer (L7)&lt;br&gt;узлы во всех трех зонах,&lt;br&gt;региональный публичный IP" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;" vertex="1" parent="cloud"><mxGeometry x="980" y="70" width="40" height="40" as="geometry"/></mxCell><mxCell id="monitoring" value="Monitoring + Managed Prometheus&lt;br&gt;метрики, логи, алерты дежурному" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;" vertex="1" parent="cloud"><mxGeometry x="2080" y="70" width="40" height="40" as="geometry"/></mxCell><mxCell id="e_users_alb" value="HTTPS: REST API веб-приложения" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="users" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_partners_alb" value="HTTPS: API партнеров&lt;br&gt;(прямой LoadBalancer Kubernetes убран)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="partners" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_alb_a" value="трафик и health check&lt;br&gt;GET /healthz каждые 5 с,&lt;br&gt;3 неудачи подряд: зона a снята" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="alb" target="ingress_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="probe_a" value="health check подов: readiness и liveness probe.&lt;br&gt;HPA масштабирует поды,&lt;br&gt;Cluster Autoscaler добавляет узлы" style="text;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="k8s_a"><mxGeometry x="290" y="350" width="260" height="110" as="geometry"/></mxCell><mxCell id="e_alb_b" value="трафик и health check&lt;br&gt;GET /healthz каждые 5 с,&lt;br&gt;3 неудачи подряд: зона b снята" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="alb" target="ingress_b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="probe_b" value="health check подов: readiness и liveness probe.&lt;br&gt;HPA масштабирует поды,&lt;br&gt;Cluster Autoscaler добавляет узлы" style="text;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="k8s_b"><mxGeometry x="290" y="350" width="260" height="110" as="geometry"/></mxCell><mxCell id="e_alb_d" value="трафик и health check&lt;br&gt;GET /healthz каждые 5 с,&lt;br&gt;3 неудачи подряд: зона d снята" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="alb" target="ingress_d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="probe_d" value="health check подов: readiness и liveness probe.&lt;br&gt;HPA масштабирует поды,&lt;br&gt;Cluster Autoscaler добавляет узлы" style="text;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;" vertex="1" parent="k8s_d"><mxGeometry x="290" y="350" width="260" height="110" as="geometry"/></mxCell><mxCell id="e_mon_alb" value="внешний health check (blackbox):&lt;br&gt;главная страница и API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=open;dashed=1;dashPattern=6 4;strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" parent="1" source="monitoring" target="alb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_mon_vpc" value="сбор метрик кластеров и ВМ БД,&lt;br&gt;алерты дежурному до жалоб клиентов" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=open;dashed=1;dashPattern=6 4;strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" parent="1" source="monitoring" target="vpc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note_failover" value='&lt;font style="font-size:14px"&gt;Фейловер на уровне клиента: active-active&lt;/font&gt;&lt;br&gt;&lt;br&gt;Все три зоны принимают трафик. ALB проверяет ingress каждого кластера и перестает слать запросы в зону, не прошедшую health check. Публичный IP ALB региональный, поэтому смена DNS-записи не нужна. Страницы веб-приложения отдаются с узлов CDN; при недоступности источника CDN отдает кеш. Клиент и партнер работают с одним адресом, переключение для них прозрачно.' style="text;align=left;verticalAlign=top;spacing=8;fontSize=12;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#5282ff;" vertex="1" parent="cloud"><mxGeometry x="1970" y="820" width="540" height="260" as="geometry"/></mxCell><mxCell id="legend" value='&lt;font style="font-size:14px"&gt;Обозначения&lt;/font&gt;&lt;br&gt;&lt;br&gt;Черная сплошная линия: трафик клиентов и сервисов.&lt;br&gt;Зеленый пунктир: служебные связи (DNS, мониторинг, развертывание).&lt;br&gt;Синяя линия: репликация и резервное копирование БД.&lt;br&gt;Желтые блоки: сервисы InsureTech, голубые: внешние участники и ВМ.' style="text;align=left;verticalAlign=top;spacing=8;fontSize=12;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#5282ff;" vertex="1" parent="cloud"><mxGeometry x="1970" y="1100" width="540" height="150" as="geometry"/></mxCell><mxCell id="haproxy_a" value="HAProxy: запись только на лидера,&lt;br&gt;чтение с реплик" style="fillColor=#fff2bf;gradientColor=none;shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);strokeColor=none;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="k8s_a"><mxGeometry x="20" y="360" width="250" height="70" as="geometry"/></mxCell><mxCell id="e_core_ha_a" value="SQL всех сервисов&lt;br&gt;зоны через HAProxy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;labelBackgroundColor=#ffffff;fontSize=11;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="core_a" target="haproxy_a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sg_a" value="Security Group БД: доступ только из подсетей кластеров" style="fillColor=none;gradientColor=none;shape=stencil(vVPLEoIgFP0aljgEVuPa6j+YRGUica6U9vdhUKk4LWzG3X0cOPdcOIilTclrgShpDOiLaGVmSsQOiFJZlQKksRFiR8TSXIMoQN+qzOU175F9dNX3/obOnSP9CUoeLktIFL8KJ4flcLZN8NhtRJiDwxsf7VwhQHjAhniCDvNONhi04UbqakSuOBQCWy6cK16MWk0rRB2U/XRKVgMlSRwl+1nyhWI+s0+Xs4KYgNvPtlBKuJvVniX4En+9yfxWVpDx2yc2+Bosl0o5fw77U0PakjMzOz4B);strokeColor=#ff5958;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="az_a"><mxGeometry x="20" y="640" width="560" height="220" as="geometry"/></mxCell><mxCell id="pg_a" value="ВМ pg-a: PostgreSQL (лидер)&lt;br&gt;Patroni, etcd (узел a из 3)&lt;br&gt;Patroni продлевает ключ лидера в etcd (health check лидера, TTL 30 с)" style="fillColor=#e3ebff;gradientColor=none;shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);strokeColor=none;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontFamily=Arial;fontColor=#000000;html=1;whiteSpace=wrap;" vertex="1" parent="sg_a"><mxGeometry x="20" y="50" width="520" height="150" as="geometry"/></mxCell><mxCell id="vm_icon_a" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;fontSize=11;fontFamily=Arial;fontColor=#