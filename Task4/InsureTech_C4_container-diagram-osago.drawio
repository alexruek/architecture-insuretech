        <object placeholders="1" c4Type="Relationship" c4Technology="тема osago-offers, группа core-app и группа каждого экземпляра для SSE" c4Description="Читает решения страховых компаний" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;%c4Description%&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;" id="ev-osago-offers-read-core">
