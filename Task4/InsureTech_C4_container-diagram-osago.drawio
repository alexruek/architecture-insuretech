        <object placeholders="1" c4Type="Relationship" c4Technology="тема osago-offers" c4Description="Публикует решения страховых по мере поступления" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;%c4Description%&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;" id="ev-osago-offers-publish">
          <mxCell edge="1" parent="1" source="osago-aggregator" style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#D79B00;whiteSpace=wrap;exitX=0.4167;exitY=0;entryX=0.3833;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="kafka">
