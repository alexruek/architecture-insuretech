        <object placeholders="1" c4Name="core-app" c4Type="Container" c4Technology="Kotlin, SpringBoot" c4Description="Монолитное приложение: • отображает данные о доступных страховых продуктах • оформляет новые страховки • отображает информацию о купленных страховках • принимает заявки на ОСАГО и передает клиенту предложения страховых компаний по мере поступления • фоновый обработчик публикует события из таблицы outbox" label="&lt;font style=&quot;font-size: 16px&quot;&gt;%c4Name%&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="uZ0quFO-MIEIE11IO5jD-3">
