        <object placeholders="1" c4Type="osago-aggregator-db" c4Container="Container" c4Technology="Redis" c4Description="Состояние опроса страховых компаний по заявкам ОСАГО: статус, время следующего опроса, срок ответа. Ключи с TTL" label="&lt;font style=&quot;font-size: 16px&quot;&gt;%c4Type%&lt;/font&gt;&lt;div&gt;[%c4Container%:&amp;nbsp;%c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="osago-aggregator-db">
